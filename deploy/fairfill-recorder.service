[Unit]
Description=Fairfill price recorder (perps, multipliers, Jupiter quote sweeps)
After=network-online.target

[Service]
WorkingDirectory=/home/khalydmaina/fairfill/api
EnvironmentFile=-/home/khalydmaina/fairfill/api/.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/usr/bin/node /home/khalydmaina/fairfill/api/node_modules/tsx/dist/cli.mjs src/recorder.ts
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
